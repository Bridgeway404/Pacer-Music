# Pacer — environment variable NAMES only. Never commit real values.
#
# The iOS app needs no secrets: it embeds only the Supabase *publishable* key,
# which is public by design and constrained by Row Level Security.
#
# Future Spotify integration (Supabase Edge Function — server-side only):
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Web reference tree (only if it ever talks to Supabase):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
